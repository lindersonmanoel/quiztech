# Copie este arquivo para ".env" (ele NÃO vai para o Git) e preencha os valores.

# Senha do PostgreSQL do contêiner. Gere uma forte, por exemplo (PowerShell):
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
POSTGRES_PASSWORD=

# Chave que assina os tokens de login. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# O usuário que se cadastrar com este e-mail vira administrador (cadastre-se logo após subir o sistema).
ADMIN_EMAIL=

# Porta em que o site abre no modo HTTP direto (padrão 8000).
APP_PORT=8000

# Só para HTTPS (docker-compose.https.yml): o domínio que aponta para a VM.
DOMAIN=
