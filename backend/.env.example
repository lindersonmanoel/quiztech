# Copie para .env (o arquivo .env não vai para o Git).
ENVIRONMENT=development
# Obrigatória em produção. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Local usa SQLite. No Railway, referencie o PostgreSQL: ${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite:///./quiztech.db
# O usuário que se cadastrar com este e-mail vira administrador.
ADMIN_EMAIL=
# Só é necessário se o frontend for servido por outra origem.
CORS_ORIGINS=
ACCESS_TOKEN_MINUTES=720
SEED_ON_STARTUP=1
