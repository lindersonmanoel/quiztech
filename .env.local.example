# Ambiente local completo (docker-compose.local.yml). Copie para ".env.local" (nao vai para o Git) e preencha.
# Senha do PostgreSQL local:
POSTGRES_PASSWORD=troque-por-uma-senha-qualquer
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-48-bytes
# Quem se cadastrar com este e-mail vira administrador.
ADMIN_EMAIL=
