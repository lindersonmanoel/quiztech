# Arquivo de producao (docker-compose.prod.yml). Copie para ".env.production" na VM, preencha os valores reais e
# NUNCA versione (ja esta no .gitignore).
# Uso: docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# --- Banco (PostgreSQL compartilhado com o Meu Bolso Digital; o script scripts/setup-banco-compartilhado.sh cria o banco) ---
# Senha do usuario "quiztech" no banco "quiztech". Gere uma forte e unica:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
QUIZTECH_DB_PASSWORD=troque-por-uma-senha-forte-e-unica
# Nome do contêiner do Postgres na rede Docker e nome dessa rede (docker ps / docker network ls).
DB_HOST=meu-bolso-digital-db-prod
REDE_DO_BANCO=meubolsodigital_default

# --- API (contêiner "backend", le todas as variaveis abaixo) ---
NODE_ENV=production
PORT=3100
# Mesma senha de QUIZTECH_DB_PASSWORD. O host e' o nome do contêiner do Postgres.
DATABASE_URL=postgresql://quiztech:troque-por-uma-senha-forte-e-unica@meu-bolso-digital-db-prod:5432/quiztech
DATABASE_SSL=false

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-48-bytes
JWT_EXPIRES_IN=12h

# Enderecos do SITE liberados no CORS (Vercel e/ou dominio proprio), separados por virgula.
FRONTEND_URL=https://quiztech-lindersonmanoel.vercel.app

# Quem se cadastrar com este e-mail vira administrador (cadastre-se logo depois de subir).
ADMIN_EMAIL=

# Intervalo (segundos) para refazer um quiz reprovado; 0 desliga.
RETAKE_COOLDOWN_SECONDS=600

# Cabecalho com o IP real do visitante, escrito pelo Cloudflare (o cliente nao consegue forja-lo). Mantenha assim
# enquanto TODO o trafego entrar pelo Cloudflare Tunnel.
CLIENT_IP_HEADER=cf-connecting-ip

# 1 = a API tambem serve o site (so' para o tunel de demonstracao). Em producao real o site fica no Vercel: 0.
SERVE_FRONTEND=0

# --- Cloudflare Tunnel nomeado (perfil "tunnel"; veja DEPLOY.md) ---
CLOUDFLARE_TUNNEL_TOKEN=troque-pelo-token-do-tunnel

# --- Opcionais ---
BACKUP_KEEP_DAYS=14
