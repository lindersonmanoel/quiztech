# Copie para ".env" (desenvolvimento local). Em producao use o .env.production da raiz (veja DEPLOY.md).
NODE_ENV=development
PORT=3100

# PostgreSQL. Local: um banco seu. Em producao: o contêiner compartilhado (veja DEPLOY.md).
DATABASE_URL=postgresql://quiztech:senha@localhost:5432/quiztech
DATABASE_SSL=false

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Enderecos do site (Vercel/dominio) liberados no CORS, separados por virgula.
FRONTEND_URL=http://localhost:5500

# Quem se cadastrar com este e-mail vira administrador.
ADMIN_EMAIL=

# Segundos de espera para refazer um quiz reprovado (0 desliga).
RETAKE_COOLDOWN_SECONDS=600

# Proxy confiavel que escreve o IP real do visitante num cabecalho (Cloudflare: cf-connecting-ip). So' defina se
# TODO o trafego passar por ele.
CLIENT_IP_HEADER=

# --- E-mail (recuperacao de senha) ---
# Qualquer servidor SMTP serve (Gmail com "senha de app", Brevo, Resend, Mailgun...). Sem SMTP_HOST a recuperacao de
# senha fica desativada e a tela avisa. Veja DEPLOY.md, secao "E-mail".
SMTP_HOST=
SMTP_PORT=587
# true so' para a porta 465 (TLS direto). Na 587 o STARTTLS e' usado automaticamente.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Remetente exibido. Vazio = "QUIZ TECH <SMTP_USER>".
SMTP_FROM=
# Endereco do SITE usado nos links dos e-mails e no QR Code do certificado. Vazio = o primeiro de FRONTEND_URL.
APP_URL=
# Validade do link de redefinicao (minutos) e fuso do ranking semanal/mensal.
RESET_TOKEN_MINUTES=60
RANKING_TZ=America/Sao_Paulo

# 1 = a API tambem serve o site (pasta frontend/). Util em demonstracao/local; em producao o site fica no Vercel.
SERVE_FRONTEND=0
